<?xml version="1.0" encoding="utf-8"?>
<!-- A tile's own surface, inset by the room kept around it for the focus ring (the ring is drawn by Tile). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="@dimen/ring_pad">
    <selector>
        <item android:state_focused="true">
            <shape>
                <solid android:color="@color/surface_focus" />
                <corners android:radius="@dimen/radius" />
            </shape>
        </item>
        <item android:state_activated="true">
            <shape>
                <solid android:color="@color/surface_focus" />
                <corners android:radius="@dimen/radius" />
            </shape>
        </item>
        <item>
            <shape>
                <solid android:color="@color/surface" />
                <corners android:radius="@dimen/radius" />
            </shape>
        </item>
    </selector>
</inset>
