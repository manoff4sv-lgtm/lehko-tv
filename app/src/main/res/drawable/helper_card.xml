<?xml version="1.0" encoding="utf-8"?>
<!-- The helper's card over other apps (TvHelper): the dark glass of Lehko's cards, nearly opaque here so the text
     reads over a bright film, with the same hairline edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#F20E1117" />
    <stroke android:width="1dp" android:color="@color/hairline" />
    <corners android:radius="16dp" />
</shape>
