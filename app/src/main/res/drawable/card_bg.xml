<?xml version="1.0" encoding="utf-8"?>
<!-- Cards (notices, status messages): see-through glass over the background with a hairline edge. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/glass" />
            <stroke android:width="2dp" android:color="@color/stroke_focus" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/glass" />
            <stroke android:width="1dp" android:color="@color/hairline" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
