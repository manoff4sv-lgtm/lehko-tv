<?xml version="1.0" encoding="utf-8"?>
<!-- Cards. The outage card can take focus when a screen reader is on: then the same white outline as tiles. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/surface" />
            <stroke android:width="2dp" android:color="@color/stroke_focus" />
            <corners android:radius="@dimen/radius" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/surface" />
            <corners android:radius="@dimen/radius" />
        </shape>
    </item>
</selector>
