<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Lehko" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:alertDialogTheme">@style/Lehko.Dialog</item>
    </style>

    <!-- The home screen: no window animation when it comes back, so Home feels instant. -->
    <style name="Lehko.Home">
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- The fireplace: black while it starts. -->
    <style name="Lehko.Fire">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>

    <style name="Lehko.Dialog" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <style name="Lehko.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>

    <style name="Lehko.Section">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
