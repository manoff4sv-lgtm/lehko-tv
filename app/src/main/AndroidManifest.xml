<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- After a reboot or a TV update: check that Lehko is still the home screen. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Uninstall" in an app's menu. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- The "unneeded apps" screen shows names of apps that are turned off (they have no tile any more). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- The memory button without debugging: Android's own "close background apps" (up to Android 13). -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+: without these the app can't see the other apps (and the TV app for the inputs). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:host="android.media.tv" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:supportsRtl="false"
        android:usesCleartextTraffic="false"
        android:theme="@style/Lehko">

        <!-- The home screen. It only becomes the TV's home after you turn Lehko on in its settings.
             No locale, fontScale or density in configChanges (here and below): many texts and sizes are set once,
             so a new language, text size or display size has to recreate the screen. -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/Lehko.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The "Lehko" tile in the app list: settings, and turning Lehko on and off. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:taskAffinity="ua.lehko.tv.settings"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AllAppsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode" />

        <!-- singleTop: a quick second OK on its row in Settings doesn't open a second copy. -->
        <activity
            android:name=".CleanupActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="ua.lehko.tv.settings"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode" />

        <!-- The fireplace after a few idle minutes on the home screen (any key goes back). -->
        <activity
            android:name=".FireplaceActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/Lehko.Fire" />

        <!-- Optional screensaver: a clock with the weather that slowly moves (no burn-in). -->
        <service
            android:name=".ClockDream"
            android:exported="true"
            android:label="@string/screensaver_lehko"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Optional screensaver: the fireplace. -->
        <service
            android:name=".FireDream"
            android:exported="true"
            android:label="@string/screensaver_fire"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Lehko's helper (TvHelper): the remote's star, YouTube and "all apps" buttons while the stock launcher is
             off, the outage warning and the sleep timer over other apps, and the input to open when the TV is turned
             on. The one exception to "one process": it runs all the time, behind every app, so it gets a small process
             of its own (a few MB) instead of keeping the home screen's in memory, and it keeps working if the home
             screen crashes (App skips the crash watchdog there). -->
        <service
            android:name=".TvHelper"
            android:process=":helper"
            android:exported="true"
            android:label="@string/helper_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/tv_helper" />
        </service>

        <!-- Background work that talks to the TV's own debugging port (switching, checks after boot). -->
        <service
            android:name=".ModeJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- The outage schedule every half hour while other apps are in front, for the helper's warning. -->
        <service
            android:name=".OutageJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
